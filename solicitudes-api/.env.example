# Copia este archivo como .env y completa los valores. NUNCA subas .env a GitHub.

# --- Modo de la API: "simple" (version base) o "mejorado" (colas + lotes + reintentos)
MODO=simple

# --- Microsoft 365 (Microsoft Entra ID -> Registro de aplicaciones)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# --- Excel en OneDrive
EXCEL_USER=jose.perez.3680@miremington.edu.co
EXCEL_FILE_PATH=Solicitudes.xlsx
EXCEL_TABLE=Solicitudes
# Opcional: flujo de Power Automate para agregar filas. Leer y actualizar requiere Graph.
EXCEL_FLOW_URL=

# --- Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# true permite Telegram real aunque SIMULAR=true; false simula Telegram si SIMULAR=true.
TELEGRAM_REAL=false

# --- Pruebas locales sin credenciales (simula Excel y Telegram)
SIMULAR=false
